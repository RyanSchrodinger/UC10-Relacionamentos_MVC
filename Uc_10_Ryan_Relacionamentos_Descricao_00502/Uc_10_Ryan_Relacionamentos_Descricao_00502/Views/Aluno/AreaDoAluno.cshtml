@{
    ViewData["Title"] = "Área do aluno";
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/aluno.css"
          asp-append-version="true" />
}

<section class="pagina-hero">
    <div class="hero-conteudo">
        <span class="etiqueta">Seu futuro começa aqui</span>

        <h1>Uma experiência de aprendizado feita para você</h1>

        <p>Acesse informações, acompanhe sua jornada e aproveite melhor seus estudos.</p>

        <div class="acoes">
            <a class="botao principal"
               asp-controller="Aluno"
               asp-action="Index">
                Ver alunos cadastrados
            </a>

            <a class="botao secundario"
               asp-controller="Aluno"
               asp-action="DicasDeEstudo">
                Ver dicas de estudo
            </a>
        </div>
    </div>

    <div class="destaque">
        <span class="simbolo">A</span>
        <strong>Educação que transforma</strong>
        <p>Conhecimento, orientação e novas possibilidades.</p>
    </div>
</section>

<section class="secao">
    <header class="titulo">
        <span>Nossos diferenciais</span>
        <h2>Uma jornada construída com você</h2>
    </header>

    <div class="grade">
        <article>
            <b>01</b>
            <h3>Aprendizado organizado</h3>
            <p>Informação e apoio para uma experiência de aprendizado melhor.</p>
        </article>

        <article>
            <b>02</b>
            <h3>Acompanhamento próximo</h3>
            <p>Informação e apoio para uma experiência de aprendizado melhor.</p>
        </article>

        <article>
            <b>03</b>
            <h3>Novas oportunidades</h3>
            <p>Informação e apoio para uma experiência de aprendizado melhor.</p>
        </article>
    </div>
</section>

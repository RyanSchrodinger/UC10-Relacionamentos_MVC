@{
    ViewData["Title"] = "Etapas da venda";
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/venda.css"
          asp-append-version="true" />
}

<section class="pagina-hero">
    <div class="hero-conteudo">
        <span class="etiqueta">Passo a passo</span>

        <h1>Etapas para registrar uma venda</h1>

        <p>Confirme se cliente, vendedor e automóvel já estão cadastrados.</p>

        <div class="acoes">
            <a class="botao principal"
               asp-controller="Venda"
               asp-action="Index">
                Acessar vendas
            </a>

            <a class="botao secundario"
               asp-controller="Venda"
               asp-action="Index">
                Voltar aos cadastros
            </a>
        </div>
    </div>

    <div class="destaque">
        <span class="simbolo">V</span>
        <strong>Escolha com confiança</strong>
        <p>Atendimento, informação e transparência em cada etapa.</p>
    </div>
</section>

<section class="secao">
    <header class="titulo">
        <span>Nossos diferenciais</span>
        <h2>Uma experiência pensada para você</h2>
    </header>

    <div class="grade">
        <article>
            <b>01</b>
            <h3>Selecione o cliente</h3>
            <p>Informações claras para tornar sua experiência mais simples e segura.</p>
        </article>

        <article>
            <b>02</b>
            <h3>Escolha o vendedor</h3>
            <p>Informações claras para tornar sua experiência mais simples e segura.</p>
        </article>

        <article>
            <b>03</b>
            <h3>Defina o automóvel</h3>
            <p>Informações claras para tornar sua experiência mais simples e segura.</p>
        </article>
    </div>
</section>

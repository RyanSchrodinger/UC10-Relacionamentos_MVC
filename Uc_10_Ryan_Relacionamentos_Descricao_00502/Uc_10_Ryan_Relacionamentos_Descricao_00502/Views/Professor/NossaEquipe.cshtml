@{
    ViewData["Title"] = "Professores";
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/professor.css"
          asp-append-version="true" />
}

<section class="pagina-hero">
    <div class="hero-conteudo">
        <span class="etiqueta">Quem ensina transforma</span>

        <h1>Professores preparados para inspirar e orientar</h1>

        <p>Conheça profissionais comprometidos com o desenvolvimento dos alunos.</p>

        <div class="acoes">
            <a class="botao principal"
               asp-controller="Professor"
               asp-action="Index">
                Ver professores cadastrados
            </a>

            <a class="botao secundario"
               asp-controller="Professor"
               asp-action="Metodologia">
                Nossa metodologia
            </a>
        </div>
    </div>

    <div class="destaque">
        <span class="simbolo">P</span>
        <strong>Educação que transforma</strong>
        <p>Conhecimento, orientação e novas possibilidades.</p>
    </div>
</section>

<section class="secao">
    <header class="titulo">
        <span>Nossos diferenciais</span>
        <h2>Uma jornada construída com você</h2>
    </header>

    <div class="grade">
        <article>
            <b>01</b>
            <h3>Experiência</h3>
            <p>Informação e apoio para uma experiência de aprendizado melhor.</p>
        </article>

        <article>
            <b>02</b>
            <h3>Acompanhamento</h3>
            <p>Informação e apoio para uma experiência de aprendizado melhor.</p>
        </article>

        <article>
            <b>03</b>
            <h3>Compromisso</h3>
            <p>Informação e apoio para uma experiência de aprendizado melhor.</p>
        </article>
    </div>
</section>

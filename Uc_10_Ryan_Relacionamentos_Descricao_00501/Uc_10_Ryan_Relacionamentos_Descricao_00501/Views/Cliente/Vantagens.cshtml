@{
    ViewData["Title"] = "Vantagens";
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/cliente.css"
          asp-append-version="true" />
}

<section class="pagina-hero">
    <div class="hero-conteudo">
        <span class="etiqueta">Experiência completa</span>

        <h1>Vantagens para nossos clientes</h1>

        <p>Do primeiro contato à entrega do automóvel, você conta com apoio e informação.</p>

        <div class="acoes">
            <a class="botao principal"
               asp-controller="Cliente"
               asp-action="Index">
                Acessar clientes
            </a>

            <a class="botao secundario"
               asp-controller="Cliente"
               asp-action="Index">
                Voltar aos cadastros
            </a>
        </div>
    </div>

    <div class="destaque">
        <span class="simbolo">C</span>
        <strong>Escolha com confiança</strong>
        <p>Atendimento, informação e transparência em cada etapa.</p>
    </div>
</section>

<section class="secao">
    <header class="titulo">
        <span>Nossos diferenciais</span>
        <h2>Uma experiência pensada para você</h2>
    </header>

    <div class="grade">
        <article>
            <b>01</b>
            <h3>Atendimento dedicado</h3>
            <p>Informações claras para tornar sua experiência mais simples e segura.</p>
        </article>

        <article>
            <b>02</b>
            <h3>Variedade de opções</h3>
            <p>Informações claras para tornar sua experiência mais simples e segura.</p>
        </article>

        <article>
            <b>03</b>
            <h3>Negociação transparente</h3>
            <p>Informações claras para tornar sua experiência mais simples e segura.</p>
        </article>
    </div>
</section>

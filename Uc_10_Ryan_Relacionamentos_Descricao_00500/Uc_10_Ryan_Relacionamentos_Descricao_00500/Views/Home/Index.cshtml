@{
    ViewData["Title"] = "Início";
}

@section Styles {
    <link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />
}

<section class="home-hero">
    <div class="home-hero-conteudo">
        <span class="home-etiqueta">Clínica Saúde</span>
        <h1>Cuidado completo para você e sua família</h1>
        <p>
            Profissionais qualificados, diferentes especialidades e um
            atendimento organizado para cuidar da sua saúde com atenção.
        </p>

        <div class="home-acoes">
            <a class="home-botao home-botao-principal"
               asp-controller="Consulta" asp-action="Agendamentos">
                Conhecer as consultas
            </a>
            <a class="home-botao home-botao-secundario"
               asp-controller="Medico" asp-action="NossaEquipe">
                Conhecer nossa equipe
            </a>
        </div>
    </div>

    <div class="home-hero-visual" aria-hidden="true">
        
        <strong>Saúde, cuidado e confiança</strong>
        <span>Atendimento pensado para cada paciente.</span>
    </div>
</section>

<section class="home-sobre">
    <div class="home-sobre-destaque">
        <span>Sobre a clínica</span>
        <h2>Um lugar preparado para cuidar de você</h2>
    </div>
    <p>
        Nosso objetivo é oferecer um atendimento simples, acolhedor e seguro.
        Reunimos pacientes, médicos, especialidades e consultas em um sistema
        organizado e fácil de utilizar.
    </p>
</section>

<section class="home-servicos">
    <header class="home-titulo-secao">
        <span>Acesse nossas áreas</span>
        <h2>Encontre o que você precisa</h2>
    </header>

    <div class="home-grade">
        <article class="home-cartao">
            <span class="home-cartao-numero">01</span>
            <h3>Médicos</h3>
            <p>Conheça os profissionais e as especialidades disponíveis na clínica.</p>
            <a asp-controller="Medico" asp-action="NossaEquipe">Conhecer equipe →</a>
        </article>

        <article class="home-cartao">
            <span class="home-cartao-numero">02</span>
            <h3>Pacientes</h3>
            <p>Acesse informações importantes e orientações para o atendimento.</p>
            <a asp-controller="Paciente" asp-action="AreaDoPaciente">Área do paciente →</a>
        </article>

        <article class="home-cartao">
            <span class="home-cartao-numero">03</span>
            <h3>Atendimentos</h3>
            <p>Veja as modalidades de consulta e descubra qual opção escolher.</p>
            <a asp-controller="TipoConsulta" asp-action="NossosAtendimentos">Ver atendimentos →</a>
        </article>

        <article class="home-cartao">
            <span class="home-cartao-numero">04</span>
            <h3>Consultas</h3>
            <p>Entenda como os atendimentos são registrados e organizados.</p>
            <a asp-controller="Consulta" asp-action="Agendamentos">Acessar consultas →</a>
        </article>
    </div>
</section>

<section class="home-chamada">
    <div>
        <span>Comece por aqui</span>
        <h2>Encontre o atendimento ideal</h2>
        <p>Conheça nossas especialidades e escolha o cuidado mais adequado.</p>
    </div>
    <a class="home-botao home-botao-claro"
       asp-controller="Medico" asp-action="Especialidades">
        Ver especialidades
    </a>
</section>

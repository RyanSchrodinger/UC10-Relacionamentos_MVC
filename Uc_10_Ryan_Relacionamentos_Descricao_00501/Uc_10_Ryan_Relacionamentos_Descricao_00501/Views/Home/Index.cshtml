@{
    ViewData["Title"] = "Início";
}

@section Styles {
    <link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />
}

<section class="home-hero">
    <div>
        <span>Ryan Motors</span>

        <h1>Seu próximo carro está mais perto</h1>

        <p>
            Automóveis, marcas e atendimento reunidos para uma escolha
            segura e transparente.
        </p>

        <div class="home-acoes">
            <a class="home-botao principal"
               asp-controller="Automovel"
               asp-action="Vitrine">
                Conhecer automóveis
            </a>

            <a class="home-botao secundario"
               asp-controller="Venda"
               asp-action="ComoComprar">
                Como comprar
            </a>
        </div>
    </div>

    <div class="home-destaque">
        <b>RM</b>

        <strong>Escolha. Negocie. Dirija.</strong>

        <p>
            Uma experiência simples do início à entrega.
        </p>
    </div>
</section>

<section class="home-secao">
    <header>
        <span>Acesse nossas áreas</span>

        <h2>Tudo para sua próxima compra</h2>
    </header>

    <div class="home-grade">
        <article>
            <b>01</b>

            <h3>Automóveis</h3>

            <p>
                Conheça os veículos disponíveis.
            </p>

            <a asp-controller="Automovel"
               asp-action="Vitrine">
                Ver vitrine →
            </a>
        </article>

        <article>
            <b>02</b>

            <h3>Marcas</h3>

            <p>
                Compare fabricantes e opções.
            </p>

            <a asp-controller="Marca"
               asp-action="NossasMarcas">
                Ver marcas →
            </a>
        </article>

        <article>
            <b>03</b>

            <h3>Clientes</h3>

            <p>
                Acesse informações e vantagens.
            </p>

            <a asp-controller="Cliente"
               asp-action="AreaDoCliente">
                Área do cliente →
            </a>
        </article>

        <article>
            <b>04</b>

            <h3>Equipe</h3>

            <p>
                Conheça nossos vendedores.
            </p>

            <a asp-controller="Vendedor"
               asp-action="NossaEquipe">
                Conhecer equipe →
            </a>
        </article>
    </div>
</section>

<section class="home-chamada">
    <div>
        <span>Negociação transparente</span>

        <h2>Entenda como funciona uma venda</h2>
    </div>

    <a class="home-botao claro"
       asp-controller="Venda"
       asp-action="ComoComprar">
        Começar
    </a>
</section>


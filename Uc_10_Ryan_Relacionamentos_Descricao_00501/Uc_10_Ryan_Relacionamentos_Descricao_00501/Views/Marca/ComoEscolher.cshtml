@{
    ViewData["Title"] = "Como escolher uma marca";
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/marca.css"
          asp-append-version="true" />
}

<section class="pagina-hero">
    <div class="hero-conteudo">
        <span class="etiqueta">Escolha consciente</span>

        <h1>Como escolher a marca ideal?</h1>

        <p>Compare suas prioridades antes de decidir qual fabricante combina com você.</p>

        <div class="acoes">
            <a class="botao principal"
               asp-controller="Marca"
               asp-action="Index">
                Acessar marcas
            </a>

            <a class="botao secundario"
               asp-controller="Marca"
               asp-action="Index">
                Voltar aos cadastros
            </a>
        </div>
    </div>

    <div class="destaque">
        <span class="simbolo">M</span>
        <strong>Escolha com confiança</strong>
        <p>Atendimento, informação e transparência em cada etapa.</p>
    </div>
</section>

<section class="secao">
    <header class="titulo">
        <span>Nossos diferenciais</span>
        <h2>Uma experiência pensada para você</h2>
    </header>

    <div class="grade">
        <article>
            <b>01</b>
            <h3>Defina suas necessidades</h3>
            <p>Informações claras para tornar sua experiência mais simples e segura.</p>
        </article>

        <article>
            <b>02</b>
            <h3>Considere a manutenção</h3>
            <p>Informações claras para tornar sua experiência mais simples e segura.</p>
        </article>

        <article>
            <b>03</b>
            <h3>Avalie a segurança</h3>
            <p>Informações claras para tornar sua experiência mais simples e segura.</p>
        </article>
    </div>
</section>

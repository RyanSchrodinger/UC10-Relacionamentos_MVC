@{
    ViewData["Title"] = "Nossas marcas";
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/marca.css"
          asp-append-version="true" />
}

<section class="pagina-hero">
    <div class="hero-conteudo">
        <span class="etiqueta">Qualidade e tradição</span>

        <h1>Marcas para diferentes estilos de direção</h1>

        <p>Conheça as fabricantes presentes em nossa seleção de automóveis.</p>

        <div class="acoes">
            <a class="botao principal"
               asp-controller="Marca"
               asp-action="Index">
                Ver marcas cadastradas
            </a>

            <a class="botao secundario"
               asp-controller="Marca"
               asp-action="ComoEscolher">
                Como escolher
            </a>
        </div>
    </div>

    <div class="destaque">
        <span class="simbolo">M</span>
        <strong>Escolha com confiança</strong>
        <p>Atendimento, informação e transparência em cada etapa.</p>
    </div>
</section>

<section class="secao">
    <header class="titulo">
        <span>Nossos diferenciais</span>
        <h2>Uma experiência pensada para você</h2>
    </header>

    <div class="grade">
        <article>
            <b>01</b>
            <h3>Confiabilidade</h3>
            <p>Informações claras para tornar sua experiência mais simples e segura.</p>
        </article>

        <article>
            <b>02</b>
            <h3>Tecnologia</h3>
            <p>Informações claras para tornar sua experiência mais simples e segura.</p>
        </article>

        <article>
            <b>03</b>
            <h3>Variedade</h3>
            <p>Informações claras para tornar sua experiência mais simples e segura.</p>
        </article>
    </div>
</section>
